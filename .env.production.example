# Shortlyst — production settings.
#   cp .env.production.example .env   then fill in the REQUIRED values and run ./deploy.sh
# See DEPLOY.md for where each value comes from.

# ---- REQUIRED ---------------------------------------------------------------
# Domain pointing at this server (DNS A record), without https://
DOMAIN=
# https://openrouter.ai → Keys
OPENROUTER_API_KEY=

# ---- Email feature (Gmail) — leave empty to run without it -----------------
# Google Cloud → OAuth client of type "Web application"
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# ---- Chrome extension (Google Sheets import/export) -------------------------
# Google Cloud → OAuth client of type "Chrome extension". Used by
# scripts/package-extension.sh to build the extension for this deployment.
GOOGLE_SHEETS_CLIENT_ID=

# ---- Langfuse (optional tracing / cost dashboard) ---------------------------
# true runs Langfuse on this server at https://LANGFUSE_DOMAIN
# (needs its own DNS record pointing at this server, e.g. langfuse.example.com)
ENABLE_LANGFUSE=false
LANGFUSE_DOMAIN=
LANGFUSE_ADMIN_EMAIL=

# ---- Tuning (defaults are fine) ---------------------------------------------
JEV_MODEL_ID=typesafe/jev-1.13
MAIL_SYNC_CRON=*/5 * * * *
MAIL_CONCURRENCY=3
MAIL_BACKFILL_DAYS=7
MAIL_TAG_NOT_CANDIDATE=false

# ---- GENERATED by deploy.sh — leave empty, never change after first deploy --
# (changing MAIL_CREDENTIALS_KEY disconnects every mailbox; changing
#  POSTGRES_PASSWORD locks the app out of its database)
SHORTLYST_API_KEY=
MAIL_CREDENTIALS_KEY=
POSTGRES_PASSWORD=
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ADMIN_PASSWORD=
LANGFUSE_DB_PASSWORD=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
