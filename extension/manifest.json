{
  "manifest_version": 3,
  "name": "Shortlyst",
  "version": "0.2.0",
  "description": "Classify LinkedIn candidate profiles against role requirements using the Jev model.",
  "key": "",
  "permissions": ["storage", "sidePanel", "tabs", "identity", "scripting"],
  "host_permissions": ["http://localhost:3000/*", "*://*.linkedin.com/*"],
  "oauth2": {
    "client_id": "104547179613-lg78oj3itb0qjl5hd58t76eo771pkomu.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/spreadsheets",
      "https://www.googleapis.com/auth/drive.metadata.readonly"
    ]
  },
  "background": {
    "service_worker": "dist/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.linkedin.com/in/*"],
      "js": ["dist/content/page-reader.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "options_page": "src/options/index.html",
  "action": {
    "default_title": "Shortlyst"
  }
}
