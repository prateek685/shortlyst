# Shortlyst — local development settings.
#   cp .env.example .env   then fill in the empty values (see SETUP.md, sections 6–7)
# Deploying to a server? Use .env.production.example and DEPLOY.md instead.

# ---- Server -----------------------------------------------------------------
PORT=3000
# Shared key the Chrome extension sends with every request (x-api-key header).
# Generate one:  openssl rand -hex 24
SHORTLYST_API_KEY=

# ---- Jev via OpenRouter (required) ------------------------------------------
# https://openrouter.ai → Keys
OPENROUTER_API_KEY=
JEV_MODEL_ID=typesafe/jev-1.13

# ---- Postgres ---------------------------------------------------------------
# docker-compose.yml uses POSTGRES_* to create the database container;
# the app connects with DATABASE_URL — keep the two in sync.
POSTGRES_USER=shortlyst
POSTGRES_PASSWORD=shortlyst
POSTGRES_DB=shortlyst
POSTGRES_PORT=5433
DATABASE_URL=postgres://shortlyst:shortlyst@localhost:5433/shortlyst
# Locally, apply database migrations with `npm run migrate`. The Docker
# deployment sets this instead so the app applies them on start:
# RUN_MIGRATIONS=true

# ---- Langfuse (optional: traces and cost of every Jev call) -----------------
# Leave the keys empty to run without it. Self-hosted setup: SETUP.md, section 5;
# or use Langfuse Cloud (LANGFUSE_HOST=https://cloud.langfuse.com).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# ---- Email feature ----------------------------------------------------------
# 32 random bytes, base64. Encrypts stored mailbox sign-ins and signs the OAuth
# state. Never change it once a mailbox is connected (it would have to reconnect).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MAIL_CREDENTIALS_KEY=
# How often mailboxes are checked (cron), and how many email threads run at once
MAIL_SYNC_CRON=*/5 * * * *
MAIL_CONCURRENCY=3
# How many days back to read when a mailbox is first connected
MAIL_BACKFILL_DAYS=7
# true also labels non-candidate mail "Shortlyst/Not a candidate" (default: left alone)
MAIL_TAG_NOT_CANDIDATE=false
# Base of the Google sign-in return address; register
# <MAIL_OAUTH_REDIRECT_BASE>/gmail/callback in the Gmail OAuth client
MAIL_OAUTH_REDIRECT_BASE=http://localhost:3000/mail/oauth

# ---- Gmail (leave empty to run without the email feature) -------------------
# Your Google Cloud project → OAuth client of type "Web application" (SETUP.md, section 6.2).
# Keep the secret in .env only — never commit it.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
