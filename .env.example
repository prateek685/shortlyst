# Server
PORT=3000
SHORTLYST_API_KEY=change-me

# Jev via OpenRouter
OPENROUTER_API_KEY=
JEV_MODEL_ID=typesafe/jev-1.13

# Postgres (docker-compose.yml reads POSTGRES_* directly for container provisioning;
# DATABASE_URL is what the app/TypeORM connects with — keep the two in sync)
POSTGRES_USER=shortlyst
POSTGRES_PASSWORD=shortlyst
POSTGRES_DB=shortlyst
POSTGRES_PORT=5433
DATABASE_URL=postgres://shortlyst:shortlyst@localhost:5433/shortlyst

# Langfuse (self-hosted v2, brought up separately — see plan doc for its own docker-compose)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# Mail intake (background job that classifies candidate emails)
# 32 random bytes, base64 — encrypts stored mailbox credentials; also signs the OAuth state.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MAIL_CREDENTIALS_KEY=
MAIL_SYNC_CRON=*/5 * * * *
MAIL_CONCURRENCY=3
MAIL_BACKFILL_DAYS=7
# true also tags non-candidate mail "Shortlyst/Not a candidate" (default: left untagged)
MAIL_TAG_NOT_CANDIDATE=false
MAIL_OAUTH_REDIRECT_BASE=http://localhost:3000/mail/oauth

# Gmail provider (Google Cloud project "shortlyst", Web OAuth client).
# Redirect URI to register: <MAIL_OAUTH_REDIRECT_BASE>/gmail/callback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
